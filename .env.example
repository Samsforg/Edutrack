# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# In production, set the following server-side secret to run DB migrations / seed
# from a CI or local environment against your Supabase project.
# SUPABASE_SERVICE_ROLE_KEY=

# Next.js
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------
# Billing / paiement (Phase 7). OPTIONNEL : sans ces variables, le
# billing fonctionne en mode "manual" (aucun paiement réel encaissé).
# Ne JAMAIS committer les valeurs réelles.
# ------------------------------------------------------------------
# PAYMENT_PROVIDER=            # ex: stripe | paystack | flutterwave
# PAYMENT_SECRET_KEY=
# PAYMENT_WEBHOOK_SECRET=      # utilisé pour signer/vérifier le webhook
